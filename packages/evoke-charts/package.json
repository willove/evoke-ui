{
  "name": "@wil-works/evoke-charts",
  "version": "0.1.1",
  "description": "Evoke Charts — 零依赖 Canvas 自绘图表库（Vue3），Evoke 生态独立图表包",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
