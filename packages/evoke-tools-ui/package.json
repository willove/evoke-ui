{
  "name": "@wil-works/evoke-tools-ui",
  "version": "0.4.0",
  "description": "Evoke Tools UI — 纯 JS Vue3 产品级 GUI 框架（工具区 / 停靠 / 外壳件 + 运行时契约，命名空间 --et-*，底座 @wil-works/evoke-business-ui）",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./styles": "./dist/evoke-tools-ui.css",
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "default": "./dist/runtime.mjs"
    },
    "./icons": {
      "types": "./dist/types/icons/index.d.ts",
      "default": "./dist/icons.mjs"
    },
    "./*": {
      "types": "./dist/types/entries/*.d.ts",
      "default": "./dist/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/check-token-rule.mjs && node scripts/check-geometry.mjs && node scripts/check-icon-names.mjs && node scripts/a11y-names.mjs && node scripts/ime-guard.mjs && node scripts/check-command-surface.mjs && node scripts/check-copy.mjs && vite build && vue-tsc --project tsconfig.build.json && node scripts/post-types.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint:tokens": "node scripts/check-token-rule.mjs",
    "lint:geometry": "node scripts/check-geometry.mjs",
    "lint:icons": "node scripts/check-icon-names.mjs",
    "lint:a11y": "node scripts/a11y-names.mjs",
    "lint:ime": "node scripts/ime-guard.mjs",
    "publish:pkg": "pnpm publish --access public --no-git-checks"
  },
  "peerDependencies": {
    "@wil-works/evoke-business-ui": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@wil-works/evoke-business-ui": "workspace:*",
    "typescript": "^5.9.2",
    "vite": "^8.0.10",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "keywords": [
    "vue3",
    "component-library",
    "tools-ui",
    "gui-framework",
    "workbench",
    "design-system"
  ],
  "author": "willove",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willove/evoke-ui.git",
    "directory": "packages/evoke-tools-ui"
  },
  "publishConfig": {
    "access": "public"
  }
}
