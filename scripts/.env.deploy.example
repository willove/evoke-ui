# 复制本文件为 scripts/.env.deploy 并填写真实信息（该文件已加入 .gitignore，不会被提交）

# SSH 目标：用户@主机，建议配置公钥免密登录（ssh-copy-id）
DEPLOY_SSH="root@your-server-ip"

# 宝塔站点根目录（与子域名一一对应，在宝塔中建站后自动生成）
DEPLOY_BUSINESS_DIR="/www/wwwroot/docs.example.com"
DEPLOY_UI_DIR="/www/wwwroot/ui.example.com"
DEPLOY_CHARTS_DIR="/www/wwwroot/charts.example.com"

# Charts 3D 文档站（新建站后把域名换成真实值）
DEPLOY_CHARTS3D_DIR="/www/wwwroot/charts3d.example.com"
